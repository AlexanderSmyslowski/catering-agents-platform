{
  "name": "catering-agents-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared-core",
    "intake-service",
    "offer-service",
    "production-service",
    "print-export",
    "backoffice-ui"
  ],
  "scripts": {
    "build": "tsc --noEmit && npm --workspace @catering/backoffice-ui run build",
    "test": "vitest run",
    "checkpoint": "bash ./scripts/create-checkpoint.sh",
    "import:recipes:caterings": "tsx scripts/import-catering-recipes.ts",
    "import:recipes:koepff": "tsx scripts/import-koepff-recipes.ts",
    "import:offer-portfolio": "tsx scripts/import-offer-portfolio.ts",
    "local:start": "bash ./scripts/start-local-stack.sh --seed-demo",
    "local:start:fresh": "bash ./scripts/start-fresh-local-stack.sh",
    "local:stop": "bash ./scripts/stop-local-stack.sh",
    "local:status": "bash ./scripts/status-local-stack.sh",
    "local:check": "bash ./scripts/check-local-ops.sh",
  "llm:synthetic-live:preflight": "tsx scripts/check-synthetic-live-llm-readiness.ts",
  "llm:synthetic-live:check": "npm run llm:synthetic-live:preflight && npm run llm:synthetic-live:probe:strict",
  "llm:synthetic-live:probe": "tsx scripts/run-synthetic-live-llm-readiness.ts",
  "llm:synthetic-live:probe:strict": "tsx scripts/run-synthetic-live-llm-readiness.ts --fail-on-eval-mismatch",
  "llm:synthetic-live:probe:mini-pilot": "tsx scripts/run-synthetic-live-llm-readiness.ts --fail-on-eval-mismatch --require-mini-pilot-ready",
  "llm:synthetic-live:check:mini-pilot": "tsx scripts/check-synthetic-live-mini-pilot.ts",
  "browser:rehearsal": "bash ./scripts/check-browser-rehearsal.sh",
    "browser:rehearsal:answer-submit": "CATERING_BROWSER_REHEARSAL_SUBMIT_ANSWERS=1 bash ./scripts/check-browser-rehearsal.sh",
    "browser:rehearsal:archive-intake": "CATERING_BROWSER_REHEARSAL_ARCHIVE_INTAKE=1 bash ./scripts/check-browser-rehearsal.sh",
    "browser:rehearsal:failed-upload": "CATERING_BROWSER_REHEARSAL_FAILED_UPLOAD=1 bash ./scripts/check-browser-rehearsal.sh",
    "browser:rehearsal:full-fresh": "bash ./scripts/check-browser-rehearsal-full-fresh.sh",
    "dev:ui": "npm --workspace @catering/backoffice-ui run dev",
    "dev:intake": "tsx intake-service/src/server.ts",
    "dev:offer": "tsx offer-service/src/server.ts",
    "dev:production": "tsx production-service/src/server.ts",
    "dev:exports": "tsx print-export/src/server.ts",
    "deploy:hetzner": "bash ./platform-infra/scripts/deploy-hetzner.sh",
    "smoke:deploy": "bash ./platform-infra/scripts/smoke-check.sh"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@mozilla/readability": "^0.6.0",
    "@vitejs/plugin-react": "^5.1.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.6.1",
    "jsdom": "^26.1.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.20.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.0",
    "@types/node": "^24.3.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "pg-mem": "^3.0.14",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.6"
  }
}
