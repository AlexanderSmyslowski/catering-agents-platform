{
  auto_https off
}

http://{$CATERING_PUBLIC_HOST} {
  reverse_proxy {$CATERING_UPSTREAM} {
    header_up Host {$CATERING_PUBLIC_HOST}
    transport http {
      tls_server_name {$CATERING_PUBLIC_HOST}
    }
  }
}

http://{$ZEITERFASSUNG_PUBLIC_HOST} {
  reverse_proxy {$ZEITERFASSUNG_UPSTREAM}
}

http://{$EVENTOS_PUBLIC_HOST} {
  reverse_proxy {$EVENTOS_UPSTREAM}
}
