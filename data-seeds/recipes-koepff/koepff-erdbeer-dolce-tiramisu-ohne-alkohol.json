  "steps": [
    {
      "index": 1,
      "instruction": "Erdbeeren waschen, putzen; ca. 1,7 kg würfeln und mit Puderzucker und Zitronensaft marinieren."
    },
    {
      "index": 2,
      "instruction": "Ca. 0,5 kg Erdbeeren pürieren; schöne Erdbeeren aus der Gesamtmenge für Dekor zurückhalten."
    },
    {
      "index": 3,
      "instruction": "Eigelb, Zucker, Vanille, Salz und Zitronenabrieb über dem Wasserbad auf 65-70 °C hell-cremig aufschlagen."
    },
    {
      "index": 4,
      "instruction": "Vom Wasserbad nehmen und lauwarm weiterschlagen."
    },
    {
      "index": 5,
      "instruction": "Mascarpone glatt rühren und die Eigelbmasse nach und nach einarbeiten."
    },
    {
      "index": 6,
      "instruction": "Sahne steif schlagen und vorsichtig unterheben."
    },
    {
      "index": 7,
      "instruction": "GN 1/1 vorbereiten und erste Lage Löffelbiskuit einlegen."
    },
    {
      "index": 8,
      "instruction": "Mit Orangensaft beträufeln; nicht schwimmen lassen."
    },
    {
      "index": 9,
      "instruction": "Hälfte der Creme auftragen, Erdbeerwürfel und etwas Püree verteilen."
    },
    {
      "index": 10,
      "instruction": "Zweite Biskuitlage auflegen, leicht tränken und restliche Creme glatt auftragen."
    },
    {
      "index": 11,
      "instruction": "Abgedeckt bei 4-6 °C mindestens 4 Stunden, besser über Nacht kühlen."
    },
    {
      "index": 12,
      "instruction": "Kurz vor Ausgabe dekorieren und in 45 Buffetportionen portionieren."
    }
  ],
