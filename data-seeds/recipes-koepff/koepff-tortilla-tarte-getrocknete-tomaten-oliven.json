  "steps": [
    {
      "index": 1,
      "instruction": "Tarteböden prüfen und gekühlt bereitstellen."
    },
    {
      "index": 2,
      "instruction": "Kartoffeln garen, ausdampfen lassen, kalt stellen und fein würfeln."
    },
    {
      "index": 3,
      "instruction": "Zwiebelwürfel in Olivenöl glasig anschwitzen und abkühlen lassen."
    },
    {
      "index": 4,
      "instruction": "Getrocknete Tomaten und Oliven fein schneiden."
    },
    {
      "index": 5,
      "instruction": "Eier mit Sahne, Salz und Pfeffer verquirlen."
    },
    {
      "index": 6,
      "instruction": "Kartoffeln, Tomaten, Oliven und Zwiebeln in die Eiermasse geben."
    },
    {
      "index": 7,
      "instruction": "Tarteböden gleichmäßig füllen; nicht überfüllen, damit sie stabil bleiben."
    },
    {
      "index": 8,
      "instruction": "Backen, bis die Füllung gestockt ist."
    },
    {
      "index": 9,
      "instruction": "Ausformen/abkühlen und bis Service gekühlt lagern oder lauwarm ausgeben."
    }
  ],
