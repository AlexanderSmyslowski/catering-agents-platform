  "steps": [
    {
      "index": 1,
      "instruction": "Garnelen prüfen, ggf. restlichen Darm entfernen und trocken tupfen."
    },
    {
      "index": 2,
      "instruction": "Pfanne oder Kipper auf 180 °C vorheizen. Garnelen in Olivenöl 60-90 Sekunden je Seite anbraten, mit Salz und Pfeffer würzen und an der dicksten Garnele 63 °C Kerntemperatur prüfen."
    },
    {
      "index": 3,
      "instruction": "Mit Limettensaft abschmecken, flach abkühlen und kalt stellen."
    },
    {
      "index": 4,
      "instruction": "Avocado-Fruchtfleisch mit Crème fraîche, Wasabi, Limettensaft und Salz fein mixen."
    },
    {
      "index": 5,
      "instruction": "Creme unmittelbar abdecken, in Spritzbeutel füllen und kalt stellen."
    },
    {
      "index": 6,
      "instruction": "Je Portion einen sauberen Cremepunkt setzen und eine Garnele auflegen."
    }
  ],
