  "steps": [
    {
      "index": 1,
      "instruction": "Gelatine 5-8 Minuten in kaltem Wasser einweichen."
    },
    {
      "index": 2,
      "instruction": "Silikonformen dünn neutral ölen, falls nötig."
    },
    {
      "index": 3,
      "instruction": "Kokoscreme, Zucker, Zitronenabrieb, Salz und Vanille auf ca. 60-70 °C erwärmen; nicht stark kochen."
    },
    {
      "index": 4,
      "instruction": "Topf vom Herd nehmen und ausgedrückte Gelatine vollständig einrühren."
    },
    {
      "index": 5,
      "instruction": "Masse 10-15 Minuten abkühlen lassen."
    },
    {
      "index": 6,
      "instruction": "Zitronensaft zuletzt einrühren."
    },
    {
      "index": 7,
      "instruction": "45 Mulden mit ca. 70-80 g Kokosmasse füllen."
    },
    {
      "index": 8,
      "instruction": "Mindestens 4 Stunden, besser über Nacht bei 4-6 °C kühlen."
    },
    {
      "index": 9,
      "instruction": "Zum sicheren Ausformen 45-60 Minuten anfrieren."
    },
    {
      "index": 10,
      "instruction": "Für das Topping ca. 900 g Brombeeren mit Zucker und Zitronensaft kurz erhitzen; mit angerührter Speisestärke leicht binden und vollständig kühlen."
    },
    {
      "index": 11,
      "instruction": "Restliche Brombeeren für sichtbare Garnitur zurückhalten."
    },
    {
      "index": 12,
      "instruction": "Kokos-Törtchen ausformen, Brombeer-Topping und frische Brombeere kurz vor Ausgabe aufsetzen."
    }
  ],
