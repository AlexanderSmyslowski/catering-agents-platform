  "steps": [
    {
      "index": 1,
      "instruction": "Spargelenden entfernen, Stangen ggf. im unteren Drittel schälen."
    },
    {
      "index": 2,
      "instruction": "Spargel kurz blanchieren oder schonend garen, abschrecken, gut trocknen und leicht mit Olivenöl marinieren."
    },
    {
      "index": 3,
      "instruction": "Parmesan fein reiben, in 45 kleinen Häufchen auf Backpapier setzen, flach drücken und knusprig backen; trocken auskühlen lassen."
    },
    {
      "index": 4,
      "instruction": "Butter schmelzen, klären und bei 55-60 °C warm halten."
    },
    {
      "index": 5,
      "instruction": "Weißwein, Wasser, Essig und Schalotten auf ca. 70-80 ml reduzieren und passieren."
    },
    {
      "index": 6,
      "instruction": "Eigelb mit warmer Reduktion über heißem, nicht kochendem Wasserbad auf 62-65 °C aufschlagen."
    },
    {
      "index": 7,
      "instruction": "Geklärte Butter zuerst tropfenweise, dann im dünnen Strahl einarbeiten."
    },
    {
      "index": 8,
      "instruction": "Mit Zitronensaft, Salz, weißem Pfeffer, Cayenne und Trüffelpaste abschmecken."
    },
    {
      "index": 9,
      "instruction": "Spargel portionieren, Sauce setzen, Parmesan-Chip erst zuletzt auflegen."
    }
  ],
