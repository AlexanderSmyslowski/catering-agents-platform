  "steps": [
    {
      "index": 1,
      "instruction": "Roastbeef parieren, würzen, dünn mit Senf einreiben und als ganzes Stück je nach Stückgröße und Produktionsmenge in Pfanne oder Kipper rundum anbraten."
    },
    {
      "index": 2,
      "instruction": "UNOX XVC305E: 80 °C Heißluft, Lüfter 1P, 0 % STEAM.Maxi. Kernfühler mittig in den dicksten Teil setzen und bis 54 °C Kerntemperatur ziehen; anschließend nach interner Kühlvorgabe zügig auskühlen und kalt stellen."
    },
    {
      "index": 3,
      "instruction": "Drillinge in Salzwasser garen, ausdampfen lassen und mit Olivenöl, Meersalz und Pfeffer marinieren."
    },
    {
      "index": 4,
      "instruction": "Tomaten entkernen und würfeln; Rauke schneiden; Schalotten fein würfeln."
    },
    {
      "index": 5,
      "instruction": "Salsa aus Tomaten, Rauke, Schalotten, Öl, Essig, Zitronensaft, Salz und Pfeffer frisch mischen."
    },
    {
      "index": 6,
      "instruction": "Für Gribiche Eier hart kochen, kalt abschrecken, pellen; Eigelb und Eiweiß trennen."
    },
    {
      "index": 7,
      "instruction": "Eigelb mit Senf, Essig, Zitronensaft, Salz, Pfeffer und Zucker glatt rühren."
    },
    {
      "index": 8,
      "instruction": "Rapsöl und Olivenöl langsam einrühren, bis die Sauce cremig gebunden ist."
    },
    {
      "index": 9,
      "instruction": "Eiweiß, Cornichons, Kapern, Schalotten und Kräuter einarbeiten und kalt abschmecken."
    },
    {
      "index": 10,
      "instruction": "Roastbeef dünn schneiden und mit Drillingen, Salsa und Gribiche in 45 Portionen anrichten."
    }
  ],
