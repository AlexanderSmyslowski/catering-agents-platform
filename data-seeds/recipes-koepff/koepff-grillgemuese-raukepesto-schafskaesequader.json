  "steps": [
    {
      "index": 1,
      "instruction": "Gemüse waschen, putzen und gleichmäßig schneiden."
    },
    {
      "index": 2,
      "instruction": "Mit Olivenöl, Salz und Pfeffer marinieren."
    },
    {
      "index": 3,
      "instruction": "Auf Grillplatte oder im heißen Ofen rösten, bis Röstaromen entstehen, aber das Gemüse noch Struktur hat."
    },
    {
      "index": 4,
      "instruction": "Gemüse auf Blechen auskühlen lassen und abtropfen."
    },
    {
      "index": 5,
      "instruction": "Sonnenblumenkerne rösten und abkühlen lassen."
    },
    {
      "index": 6,
      "instruction": "Rauke, Öl, Sonnenblumenkerne, Knoblauch, Zitronensaft und Salz kurz zu Pesto mixen."
    },
    {
      "index": 7,
      "instruction": "Schafskäse in 45 gleichmäßige Quader schneiden."
    },
    {
      "index": 8,
      "instruction": "Gemüse portionieren, Pesto setzen, Schafskäsequader sichtbar auflegen."
    }
  ],
