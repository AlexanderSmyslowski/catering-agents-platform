  "steps": [
    {
      "index": 1,
      "instruction": "Kalbsnuss parieren, trocken tupfen, mit Salz und Pfeffer würzen."
    },
    {
      "index": 2,
      "instruction": "In Rapsöl rundum kurz anbraten."
    },
    {
      "index": 3,
      "instruction": "Bei niedriger Temperatur schonend rosa garen; Kerntemperatur nach interner Vorgabe festlegen."
    },
    {
      "index": 4,
      "instruction": "Sofort flach auskühlen lassen und vollständig durchkühlen, ideal über Nacht."
    },
    {
      "index": 5,
      "instruction": "Für die Sauce Thunfisch, Eigelb, Dijon, Zitronensaft, Kapern und Sardellen fein mixen."
    },
    {
      "index": 6,
      "instruction": "Rapsöl langsam einlaufen lassen, bis eine stabile, glatte Sauce entsteht."
    },
    {
      "index": 7,
      "instruction": "Mit kaltem Wasser auf nappierende Konsistenz bringen und kalt abschmecken."
    },
    {
      "index": 8,
      "instruction": "Kalb sehr dünn aufschneiden und 45 Portionen bilden."
    },
    {
      "index": 9,
      "instruction": "Sauce anteilig auftragen oder separat punktuell nappieren, mit Riesenkapern garnieren."
    }
  ],
