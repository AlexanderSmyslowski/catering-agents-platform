# Names only; operators bind root-owned 0600 files out of band.
CATERING_BACKUP_EXPECTED_HOST_SHA256=
CATERING_BACKUP_SOURCE_COMMIT=
CATERING_BACKUP_SOURCE_TREE=
CATERING_BACKUP_REPOSITORY_FILE=
CATERING_BACKUP_PASSWORD_FILE=
CATERING_BACKUP_EXPECTED_REPOSITORY_SHA256=
# SHA-256 of the canonical repository locator line without its terminal LF.
CATERING_BACKUP_EXPECTED_REPOSITORY_ID=
CATERING_BACKUP_PRODUCTION_HOST_SHA256=
# Canonical live interface addresses plus separately operator-attested
# external production addresses; provisioned out of band and never printed.
# External must be the exact lower-case token `none` or a comma-separated list
# of IP literals; `none` explicitly attests that no NAT/floating address exists.
CATERING_BACKUP_PRODUCTION_INTERFACE_ADDRESSES=
CATERING_BACKUP_PRODUCTION_EXTERNAL_ADDRESSES=
CATERING_BACKUP_PRODUCTION_ADDRESSES_SHA256=
CATERING_OFFHOST_ATTESTATION_FILE=
CATERING_OFFHOST_ATTESTATION_SHA256=
CATERING_SECRET_RECOVERY_ATTESTATION_FILE=
CATERING_SECRET_RECOVERY_ATTESTATION_SHA256=
# Closed-world operator source class and non-secret canonical locator only.
# Use github_environment:<owner>/<repo>/<environment> or
# offline_vault:/<absolute-locator>; the validator computes its SHA-256.
CATERING_SECRET_RECOVERY_SOURCE_TYPE=
CATERING_SECRET_RECOVERY_SOURCE_REFERENCE=
# Digest of the repository-defined required secret-name/schema catalogue.
CATERING_REQUIRED_SECRET_SCHEMA_SHA256=
# Both attestation files are operator-provisioned, non-secret, root-owned 0600
# records. Production accepts only status=operator_attested and the closed
# world fields documented in the runbook; test-only clock/address overrides
# are intentionally not part of this environment contract.
# CATERING_BACKUP_TEST_MODE=1 is accepted only by non-root hermetic tests.
CATERING_RESTORE_POSTGRES_IMAGE=
CATERING_SECRET_RECOVERY_REFERENCE_SHA256=
CATERING_BACKUP_ROOT=/var/lib/catering-backup
CATERING_RESTORE_RUNTIME_ROOT=/run/catering-backup
CATERING_RESTIC_COMMAND=restic
CATERING_DOCKER_COMMAND=docker
CATERING_PG_DUMP_COMMAND=pg_dump
